rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let user = getUserData();
      return isAuthenticated() && (user.role == 'admin' || (user.roles != null && 'admin' in user.roles));
    }

    function isStaff() {
      let user = getUserData();
      return isAuthenticated() && (
        user.role in ['admin', 'teacher', 'registrar', 'hod'] ||
        (user.roles != null && ('admin' in user.roles || 'teacher' in user.roles || 'registrar' in user.roles || 'hod' in user.roles))
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    match /schoolUsers/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Classes / Courses
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Registration Logs & Applications
    match /registration_logs/{logId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Announcements & Resources
    match /announcements/{annId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /resources/{resId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Departments & Role Permissions
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /role_permissions/{permId} {
      allow read, write: if isAuthenticated();
    }

    match /rolePermissions/{permId} {
      allow read, write: if isAuthenticated();
    }

    match /attendance/{attId} {
      allow read, write: if isAuthenticated();
    }

    match /fcmNotificationQueue/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // System Action Logs
    match /system_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Academy info, news, faqs, feature cards, landing page settings, class types, locations, discount rules, sba hub options
    match /academy_info/{id} { allow read, write: if isAuthenticated(); }
    match /academyInfo/{id} { allow read, write: if isAuthenticated(); }
    match /schoolNews/{id} { allow read, write: if isAuthenticated(); }
    match /faqs/{id} { allow read, write: if isAuthenticated(); }
    match /featureCards/{id} { allow read, write: if isAuthenticated(); }
    match /landingPageSettings/{id} { allow read, write: if isAuthenticated(); }
    match /classTypes/{id} { allow read, write: if isAuthenticated(); }
    match /locations/{id} { allow read, write: if isAuthenticated(); }
    match /discountRules/{id} { allow read, write: if isAuthenticated(); }
    match /sbaHubOptions/{id} { allow read, write: if isAuthenticated(); }
    match /resourceCategories/{id} { allow read, write: if isAuthenticated(); }
    match /addDropRequests/{id} { allow read, write: if isAuthenticated(); }
    match /registrations/{id} { allow read, write: if isAuthenticated(); }
    match /teachers/{id} { allow read, write: if isAuthenticated(); }
  }
}
