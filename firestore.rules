rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let user = getUserData();
      return isAuthenticated() && (user.role == 'admin' || (user.roles != null && 'admin' in user.roles));
    }

    function isStaff() {
      let user = getUserData();
      return isAuthenticated() && (
        user.role in ['admin', 'teacher', 'registrar', 'hod'] ||
        (user.roles != null && ('admin' in user.roles || 'teacher' in user.roles || 'registrar' in user.roles || 'hod' in user.roles))
      );
    }

    function checkAgeValue(val) {
      return val == null || val == '' || 
        (val is string && val.matches('^[0-9]+$') ? int(val) >= 14 && int(val) <= 100 : true) || 
        (val is number ? val >= 14 && val <= 100 : true);
    }

    function hasValidAges(res) {
      return (!('age' in res) || checkAgeValue(res.age)) &&
             (!('studentAge' in res) || checkAgeValue(res.studentAge)) &&
             (!('motherAge' in res) || checkAgeValue(res.motherAge)) &&
             (!('fatherAge' in res) || checkAgeValue(res.fatherAge)) &&
             (!('guardianAge' in res) || checkAgeValue(res.guardianAge)) &&
             (!('studentDetails' in res) || (
                (!('age' in res.studentDetails) || checkAgeValue(res.studentDetails.age)) && 
                (!('studentAge' in res.studentDetails) || checkAgeValue(res.studentDetails.studentAge))
             ));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    match /schoolUsers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && hasValidAges(request.resource.data);
    }

    match /users_student/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && hasValidAges(request.resource.data);
    }

    match /users_teacher/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && hasValidAges(request.resource.data);
    }

    match /users_admin/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && hasValidAges(request.resource.data);
    }

    match /users_registrar/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && hasValidAges(request.resource.data);
    }

    match /users_hod/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && hasValidAges(request.resource.data);
    }

    // Classes / Courses
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Registration Logs & Applications
    match /registration_logs/{logId} {
      allow read: if isAuthenticated() && (isAdmin() || request.resource == null || request.auth.uid == resource.data.userId || resource == null);
      allow create: if isAuthenticated() && hasValidAges(request.resource.data) && (isAdmin() || (getUserData().status in ['accepted', 'enrolled_paid', 'pending_verification']));
      allow update: if isAuthenticated() && hasValidAges(request.resource.data) && (isAdmin() || (request.auth.uid == resource.data.userId && getUserData().status in ['accepted', 'enrolled_paid', 'pending_verification']));
      allow delete: if isAdmin();
    }

    // Announcements & Resources
    match /announcements/{annId} {
      allow read: if isStaff() || (isAuthenticated() && (resource.data.classId == 'all' || resource.data.classId in getUserData().assignedClassIds));
      allow create: if isStaff() && (isAdmin() || request.resource.data.classId in getUserData().assignedClassIds);
      allow update: if isStaff() && (isAdmin() || resource.data.classId in getUserData().assignedClassIds);
      allow delete: if isStaff() && (isAdmin() || resource.data.classId in getUserData().assignedClassIds);
    }

    match /resources/{resId} {
      allow read: if isStaff() || (
        isAuthenticated() 
        && (resource.data.classId == 'all' || resource.data.classId in getUserData().assignedClassIds)
        && getUserData().status == 'enrolled_paid'
      );
      allow create: if isStaff() && (isAdmin() || request.resource.data.classId in getUserData().assignedClassIds);
      allow update: if isStaff() && (isAdmin() || resource.data.classId in getUserData().assignedClassIds);
      allow delete: if isStaff() && (isAdmin() || resource.data.classId in getUserData().assignedClassIds);
    }

    // Departments & Role Permissions
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /role_permissions/{permId} {
      allow read, write: if isAuthenticated();
    }

    match /rolePermissions/{permId} {
      allow read, write: if isAuthenticated();
    }

    match /attendance/{attId} {
      allow read, write: if isAuthenticated();
    }

    match /fcmNotificationQueue/{notifId} {
      allow read, write: if isAuthenticated();
    }

    match /fcmTokens/{tokenId} {
      allow read, write: if isAuthenticated();
    }

    // System Action Logs
    match /system_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Academy info, news, faqs, feature cards, landing page settings, class types, locations, discount rules, sba hub options
    match /academy_info/{id} { allow read, write: if isAuthenticated(); }
    match /academyInfo/{id} { allow read, write: if isAuthenticated(); }
    match /schoolNews/{id} { allow read, write: if isAuthenticated(); }
    match /faqs/{id} { allow read, write: if isAuthenticated(); }
    match /featureCards/{id} { allow read, write: if isAuthenticated(); }
    match /landingPageSettings/{id} { allow read, write: if isAuthenticated(); }
    match /classTypes/{id} { allow read, write: if isAuthenticated(); }
    match /locations/{id} { allow read, write: if isAuthenticated(); }
    match /discountRules/{id} { allow read, write: if isAuthenticated(); }
    match /sbaHubOptions/{id} { allow read, write: if isAuthenticated(); }
    match /resourceCategories/{id} { allow read, write: if isAuthenticated(); }
    match /addDropRequests/{id} { allow read, write: if isAuthenticated(); }
    match /registrations/{id} { allow read, write: if isAuthenticated(); }
    match /teachers/{id} { allow read, write: if isAuthenticated(); }
  }
}
