rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function checkAgeValue(val) {
      return val == null || val == '' || 
        (val is string && val.matches('^[0-9]+$') ? int(val) >= 14 && int(val) <= 100 : true) || 
        (val is number ? val >= 14 && val <= 100 : true);
    }

    function hasValidAges(res) {
      return res == null || (
             (!('age' in res) || checkAgeValue(res.age)) &&
             (!('studentAge' in res) || checkAgeValue(res.studentAge)) &&
             (!('motherAge' in res) || checkAgeValue(res.motherAge)) &&
             (!('fatherAge' in res) || checkAgeValue(res.fatherAge)) &&
             (!('guardianAge' in res) || checkAgeValue(res.guardianAge)) &&
             (!('studentDetails' in res) || (
                (!('age' in res.studentDetails) || checkAgeValue(res.studentDetails.age)) && 
                (!('studentAge' in res.studentDetails) || checkAgeValue(res.studentDetails.studentAge))
             ))
      );
    }

    // User Collections
    match /users/{userId} {
      allow read, write: if true;
    }

    match /schoolUsers/{userId} {
      allow read, write: if true;
    }

    match /users_student/{userId} {
      allow read, write: if true;
    }

    match /users_teacher/{userId} {
      allow read, write: if true;
    }

    match /users_admin/{userId} {
      allow read, write: if true;
    }

    match /users_registrar/{userId} {
      allow read, write: if true;
    }

    match /users_hod/{userId} {
      allow read, write: if true;
    }

    // Classes / Courses
    match /classes/{classId} {
      allow read, write: if true;
    }

    // Registration Logs & Applications
    match /registration_logs/{logId} {
      allow read, write: if true;
    }

    match /registrations/{id} {
      allow read, write: if true;
    }

    // Announcements & Resources
    match /announcements/{annId} {
      allow read, write: if true;
    }

    match /resources/{resId} {
      allow read, write: if true;
    }

    // Departments & Role Permissions
    match /departments/{deptId} {
      allow read, write: if true;
    }

    match /role_permissions/{permId} {
      allow read, write: if true;
    }

    match /rolePermissions/{permId} {
      allow read, write: if true;
    }

    match /attendance/{attId} {
      allow read, write: if true;
    }

    match /fcmNotificationQueue/{notifId} {
      allow read, write: if true;
    }

    match /fcmTokens/{tokenId} {
      allow read, write: if true;
    }

    // System Action Logs
    match /system_logs/{logId} {
      allow read, write: if true;
    }

    match /systemActionLogs/{logId} {
      allow read, write: if true;
    }

    // Form Field Settings & Settings
    match /formFieldSettings/{id} {
      allow read, write: if true;
    }

    // Academy info, news, faqs, feature cards, landing page settings, class types, locations, discount rules, sba hub options
    match /academy_info/{id} { allow read, write: if true; }
    match /academyInfo/{id} { allow read, write: if true; }
    match /schoolNews/{id} { allow read, write: if true; }
    match /faqs/{id} { allow read, write: if true; }
    match /featureCards/{id} { allow read, write: if true; }
    match /landingPageSettings/{id} { allow read, write: if true; }
    match /classTypes/{id} { allow read, write: if true; }
    match /locations/{id} { allow read, write: if true; }
    match /discountRules/{id} { allow read, write: if true; }
    match /sbaHubOptions/{id} { allow read, write: if true; }
    match /resourceCategories/{id} { allow read, write: if true; }
    match /addDropRequests/{id} { allow read, write: if true; }
    match /teachers/{id} { allow read, write: if true; }

    // Catch-all default
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

